{
  "expo": {
    "name": "Selah",
    "slug": "selah",
    "scheme": "selah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#130D1B",
    "ios": {
      "bundleIdentifier": "app.selah.prayer",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSFaceIDUsageDescription": "Selah uses Face ID to unlock the app when you turn on the passcode lock.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.selah.prayer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#B6AEFF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_BIOMETRIC",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#130D1B"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#B6AEFF"
        }
      ],
      [
        "expo-local-authentication",
        { "faceIDPermission": "Selah uses Face ID to unlock the app when you turn on the passcode lock." }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Selah uses your photos only when you pick a background for a share card." }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Selah saves share cards to your photo library when you ask it to.",
          "savePhotosPermission": "Selah saves share cards to your photo library when you ask it to.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-audio",
        { "microphonePermission": false }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    }
  }
}
